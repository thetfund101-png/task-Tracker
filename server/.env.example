# Reference template for deployment; the server loads the repository-root .env file.
NODE_ENV=production
PORT=4000
CLIENT_ORIGIN=https://your-frontend.example.com
TRUST_PROXY_HOPS=1
WEEKLY_PLAN_EDITOR_EMAIL=infothetfund@gmail.com

# Production MySQL/MariaDB credentials.
DB_HOST=your-database-host
DB_PORT=3306
DB_NAME=your-database-name
DB_USER=your-runtime-database-user
DB_PASSWORD=replace-with-a-production-database-password
DB_MIGRATION_USER=your-migration-database-user
DB_MIGRATION_PASSWORD=replace-with-a-production-migration-password

# Set different, randomly generated secrets of at least 32 characters.
JWT_ACCESS_SECRET=replace-with-a-random-access-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-refresh-secret-of-at-least-32-characters
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# Required only for the one-time initial administrator seed.
ADMIN_NAME=Your administrator name
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=replace-with-a-strong-unique-password
